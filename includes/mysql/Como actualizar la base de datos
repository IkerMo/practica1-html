Ir a la bistro_fdi y darle a SQL 
y añadir este codigo

Entrar en la base de datos bistro_fdi.
Ir a la pestaña SQL.
Pegar este código.
Pulsar Continuar.

ALTER TABLE productos
    ADD COLUMN IF NOT EXISTS requiere_cocina BOOLEAN DEFAULT TRUE AFTER ofertado;

ALTER TABLE lineaspedido
    ADD COLUMN IF NOT EXISTS estado_cocina ENUM('pendiente', 'listo_cocina', 'no_requiere_cocina') NOT NULL DEFAULT 'pendiente' AFTER subtotal_con_iva,
    ADD COLUMN IF NOT EXISTS cocinero_id INT NULL AFTER estado_cocina,
    ADD COLUMN IF NOT EXISTS fecha_listo_cocina DATETIME NULL AFTER cocinero_id;

SET @fk_exists := (
    SELECT COUNT(*)
    FROM information_schema.TABLE_CONSTRAINTS
    WHERE CONSTRAINT_SCHEMA = DATABASE()
      AND TABLE_NAME = 'lineaspedido'
      AND CONSTRAINT_NAME = 'fk_lineas_cocinero'
);

SET @sql := IF(
    @fk_exists = 0,
    'ALTER TABLE lineaspedido ADD CONSTRAINT fk_lineas_cocinero FOREIGN KEY (cocinero_id) REFERENCES usuarios(id) ON DELETE SET NULL',
    'SELECT "fk_lineas_cocinero ya existe"'
);

PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

UPDATE productos
SET requiere_cocina = FALSE
WHERE categoria_id IN (
    SELECT id FROM categorias WHERE nombre = 'Bebidas'
);

UPDATE lineaspedido lp
JOIN productos p ON lp.producto_id = p.id
SET lp.estado_cocina = IF(p.requiere_cocina = 1, 'pendiente', 'no_requiere_cocina');

